#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define FUN_L 1
#define NAV_L 2
#define POI_L 3
#define NUM_L 4
#define SYM_L 5

/ {
    chosen {
        zmk,matrix_transform = &transform_with_encoder;
    };
};

&encoder {
    status = "okay";
};

&sensors {
    status = "okay";
    triggers-per-rotation = <9>;
};

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick_tap_ms = <200>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow mods";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        double_arrow: double_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };
        arrow: arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_excl {
            timeout-ms = <50>;
            key-positions = <10 0>;
            bindings = <&kp EXCL>;
        };
        combo_at {
            timeout-ms = <50>;
            key-positions = <11 1>;
            bindings = <&kp AT>;
        };
        combo_hash {
            timeout-ms = <50>;
            key-positions = <12 2>;
            bindings = <&kp HASH>;
        };
        combo_dllr {
            timeout-ms = <50>;
            key-positions = <13 3>;
            bindings = <&kp DLLR>;
        };
        combo_prcnt {
            timeout-ms = <50>;
            key-positions = <14 4>;
            bindings = <&kp PRCNT>;
        };
        combo_caret {
            timeout-ms = <50>;
            key-positions = <15 5>;
            bindings = <&kp CARET>;
        };
        combo_amps {
            timeout-ms = <50>;
            key-positions = <16 6>;
            bindings = <&kp AMPS>;
        };
        combo_astrk {
            timeout-ms = <50>;
            key-positions = <17 7>;
            bindings = <&kp ASTRK>;
        };
        combo_lpar {
            timeout-ms = <50>;
            key-positions = <18 8>;
            bindings = <&kp LPAR>;
        };
        combo_rpar {
            timeout-ms = <50>;
            key-positions = <19 9>;
            bindings = <&kp RPAR>;
        };
        combo_capsword {
            timeout-ms = <50>;
            key-positions = <13 16>;
            bindings = <&caps_word>;
        };
        combo_double_arrow {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&double_arrow>;
        };
        combo_arrow {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&arrow>;
        };
        combo_comment {
            timeout-ms = <50>;
            key-positions = <23 24>;
            bindings = <&kp LG(FSLH)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp QUOT       &kp COMMA  &kp DOT     &kp P          &kp Y         &kp F            &kp G          &kp C       &kp R      &kp L
                &hm LCTRL A    &hm LALT O &hm LGUI E  &hm LSHFT U    &kp I         &kp D            &hm RSHFT H    &hm RGUI T  &hm LALT N &hm RCTRL S
                &lt POI_L SEMI &kp Q      &kp J       &kp K          &kp X         &kp B            &kp M          &kp W       &kp V      &lt FUN_L Z
                                                   &lt FUN_L TAB  &lt NAV_L BKSP      &lt NUM_L SPACE   &lt SYM_L ENTER   &kp ESC
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        fun_layer {
            bindings = <
                &kp F1     &kp F2     &kp F3      &kp F4          &kp F5       &kp F6           &kp F7             &kp F8          &kp F9     &kp F10
                &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT       &trans       &kp C_VOL_UP     &kp LS(LEFT)       &kp LS(UP)      &kp LS(DOWN) &kp LS(RIGHT)
                &trans     &trans     &trans      &trans          &trans       &kp C_VOL_DN     &caps_word         &kp LS(LG(N4))  &kp F11    &kp F12
                                                  &trans          &trans       &trans           &trans            &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        nav_layer {
            bindings = <
                &trans     &trans     &trans      &trans          &trans       &trans           &msc SCRL_LEFT &msc SCRL_UP &msc SCRL_DOWN &msc SCRL_RIGHT
                &kp LGUI   &kp LALT   &kp LCTRL   &kp LSHFT       &trans       &kp CAPS         &kp LARW       &kp UARW    &kp DARW   &kp RARW
                &trans     &trans     &trans      &trans          &trans       &kp INS          &kp HOME       &kp PG_UP   &kp PG_DN  &kp END
                                                  &trans          &trans       &kp SPACE        &kp ENTER     &kp DEL
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        pointer_layer {
            bindings = <
                &bootloader &sys_reset &trans      &trans          &trans       &trans           &trans         &trans      &trans     &trans
                &kp LCTRL   &kp LALT   &kp LGUI    &kp LSHFT       &trans       &trans           &kp RSHFT      &kp RGUI    &kp LALT   &kp RCTRL
                &trans      &trans     &mkp MB5    &mkp MB4        &mkp MB3     &mkp MB3         &mkp MB4       &mkp MB5    &trans     &trans
                                                   &mkp MB2        &mkp MB1     &mkp MB1         &mkp MB2       &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            bindings = <
                &kp N1     &kp N2     &kp N3      &kp N4          &kp N5       &kp N6           &kp N7         &kp N8      &kp N9     &kp N0
                &kp LBKT   &trans     &trans      &trans          &kp BSLH     &trans           &kp RSHFT      &kp RCTRL   &kp LALT   &kp RGUI
                &kp RBKT   &trans     &trans      &trans          &kp FSLH     &trans           &trans         &trans      &trans     &trans
                                                  &kp MINUS       &kp EQUAL    &kp DOT          &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        sym_layer {
            bindings = <
                &kp EXCL   &kp AT     &kp HASH    &kp DLLR        &kp PRCNT    &kp CARET        &kp AMPS       &kp ASTRK   &kp LPAR   &kp RPAR
                &kp LBRC   &trans     &trans      &trans          &kp PIPE     &trans           &kp RSHFT      &kp RCTRL   &kp LALT   &kp RGUI
                &kp RBRC   &trans     &trans      &trans          &kp QMARK    &trans           &trans         &trans      &trans     &trans
                                                  &kp UNDER       &kp PLUS     &kp TILDE        &trans         &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };
    };
};
